{
  "entities": {
    "Design": {
      "title": "Design",
      "description": "Tailoring design catalog item for ladies or gents",
      "type": "object",
      "properties": {
        "designId": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 128 },
        "gender": { "type": "string", "enum": ["Ladies", "Gents"] },
        "mainCategory": { "type": "string", "maxLength": 64 },
        "subcategory": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 1000 },
        "fabric": { "type": "string", "maxLength": 64 },
        "colors": { "type": "array" },
        "occasion": { "type": "string", "maxLength": 64 },
        "price": { "type": "number" },
        "images": { "type": "array" },
        "sizeOptions": { "type": "string", "maxLength": 128 },
        "featured": { "type": "boolean" },
        "newArrival": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["designId", "name", "gender", "mainCategory", "price"]
    },
    "Enquiry": {
      "title": "Enquiry",
      "description": "Customer tailoring service enquiry",
      "type": "object",
      "properties": {
        "enquiryId": { "type": "string", "maxLength": 64 },
        "designId": { "type": "string", "maxLength": 32 },
        "designName": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 24 },
        "service": { "type": "string", "maxLength": 64 },
        "requirements": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["new", "contacted", "completed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["customerName", "phone"]
    },
    "ShopConfig": {
      "title": "ShopConfig",
      "description": "Configurable business information for Sangeetha Tailors",
      "type": "object",
      "properties": {
        "whatsappNumber": { "type": "string", "maxLength": 24 },
        "phoneNumber": { "type": "string", "maxLength": 24 },
        "address": { "type": "string", "maxLength": 256 },
        "businessHours": { "type": "string", "maxLength": 256 },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/designs/{designId}": {
      "schema": "Design",
      "description": "Public catalog of tailoring designs"
    },
    "/enquiries/{enquiryId}": {
      "schema": "Enquiry",
      "description": "Customer enquiries for custom stitching and measurements"
    },
    "/config/{configId}": {
      "schema": "ShopConfig",
      "description": "Store configuration and contact details"
    }
  }
}
